<!DOCTYPE template>
<!--
  RbxOriginal :: decks/deckbox.xml
  The square box at the far left of a rekordbox deck: the big deck number,
  a < > pair under it and a thin strip at the bottom.

      [    1    ]      deck number
      [ < ][ > ]       beat jump back / forward (right-click: halve / double)
      [   4    ]       beat jump size
  Variables: ChanNum, Group
-->
<Template>
  <WidgetGroup>
    <ObjectName>RbxDeckBox</ObjectName>
    <Layout>vertical</Layout>
    <Size>76f,150f</Size>
    <Children>
      <WidgetGroup><Size>0me,8f</Size></WidgetGroup>
      <Label>
        <ObjectName>DeckNumberBig</ObjectName>
        <Size>76f,62f</Size>
        <Alignment>center</Alignment>
        <Text><Variable name="ChanNum"/></Text>
      </Label>
      <WidgetGroup><Size>0me,2f</Size></WidgetGroup>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>76f,36f</Size>
        <Children>
          <Template src="skin:controls/btn_1state_right.xml">
            <SetVariable name="TooltipId">beatjump_backward</SetVariable>
            <SetVariable name="ObjectName">DeckBoxArrow</SetVariable>
            <SetVariable name="Size">37f,36f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">&#10094;</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,beatjump_backward</SetVariable>
            <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,beatjump_size_halve</SetVariable>
          </Template>
          <WidgetGroup><Size>2f,0me</Size></WidgetGroup>
          <Template src="skin:controls/btn_1state_right.xml">
            <SetVariable name="TooltipId">beatjump_forward</SetVariable>
            <SetVariable name="ObjectName">DeckBoxArrow</SetVariable>
            <SetVariable name="Size">37f,36f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">&#10095;</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,beatjump_forward</SetVariable>
            <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,beatjump_size_double</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
      <WidgetGroup><Size>0me,4f</Size></WidgetGroup>
      <BeatSpinBox>
        <TooltipId>beatjump_size</TooltipId>
        <ObjectName>DeckBoxJumpSize</ObjectName>
        <Size>76f,22f</Size>
        <Value><Variable name="Group"/>,beatjump_size</Value>
      </BeatSpinBox>
      <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
