<!DOCTYPE template>
<!--
  RbxFlow :: fx/panel.xml
  Rack horizontal de efeitos: FX 1 e FX 2 lado a lado, uma linha de 34 px
  cada, centralizados.
  Visibilidade controlada pelo botão FX na barra superior.
-->
<Template>
  <WidgetGroup>
    <ObjectName>RbxEffectsPanel</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,36f</Size>
    <Children>
      <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
      <Template src="skin:fx/unit.xml">
        <SetVariable name="Unit">1</SetVariable>
      </Template>
      <WidgetGroup><Size>32f,0me</Size></WidgetGroup>
      <Template src="skin:fx/unit.xml">
        <SetVariable name="Unit">2</SetVariable>
      </Template>
      <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey persist="true">[RbxOriginal],show_fx</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
