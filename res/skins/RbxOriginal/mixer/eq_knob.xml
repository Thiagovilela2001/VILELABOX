<!DOCTYPE template>
<!--
  RbxOriginal :: mixer/eq_knob.xml
  One EQ band as in rekordbox: the knob, and under it the band name, which is
  the kill button (rekordbox's eqHighOff / eqHighOn: grey plate; killed = blue
  outline with a diagonal). Right click on the knob kills the band as well.
  Variables: ChanNum, EqParameter (1=low,2=mid,3=high), EqRange, EqLabel
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <SetVariable name="EqFxUnit">[EqualizerRack1_<Variable name="Group"/>]</SetVariable>
  <SetVariable name="EqEffect">[EqualizerRack1_<Variable name="Group"/>_Effect1]</SetVariable>

  <WidgetGroup>
    <ObjectName>RbxEqKnob<Variable name="ChanNum"/><Variable name="EqRange"/></ObjectName>
    <Layout>vertical</Layout>
    <!-- 80f = the channel column, so the knob is centred under TRIM/CFX;
         0max = height follows the content and never pushes the fader off. -->
    <Size>80f,0max</Size>
    <Children>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>80f,30f</Size>
        <Children>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
          <EffectParameterKnobComposed>
            <ObjectName>EqKnob</ObjectName>
            <Size>30f,30f</Size>
            <TooltipId>filter<Variable name="EqRange"/></TooltipId>
            <Knob scalemode="STRETCH_ASPECT">skin:bases/knob_indicator_rb.svg</Knob>
            <MinAngle><Variable name="PotiMinAngle"/></MinAngle>
            <MaxAngle><Variable name="PotiMaxAngle"/></MaxAngle>
            <ArcRadius>12</ArcRadius>
            <ArcThickness>2</ArcThickness>
            <ArcColor>#1473eb</ArcColor>
            <!-- without a non-zero ArcBgThickness the parser never reads
                 ArcBgColor, and the ring (rekordbox's whole knob) is gone -->
            <ArcBgColor>#3a3a3a</ArcBgColor>
            <ArcBgThickness>2</ArcBgThickness>
            <ArcRoundCaps><Variable name="ArcRoundCaps"/></ArcRoundCaps>
            <KnobCenterYOffset>0</KnobCenterYOffset>
            <EffectUnitGroup><Variable name="EqFxUnit"/></EffectUnitGroup>
            <Effect>1</Effect>
            <EffectParameter><Variable name="EqParameter"/></EffectParameter>
            <Connection>
              <ConfigKey><Variable name="EqEffect"/>,parameter<Variable name="EqParameter"/></ConfigKey>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="EqEffect"/>,button_parameter<Variable name="EqParameter"/></ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
          </EffectParameterKnobComposed>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>0me,1f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>80f,14f</Size>
        <Children>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Clique para cortar (kill) esta banda do EQ; clique de novo para voltar.</Tooltip>
            <ObjectName>EqKill</ObjectName>
            <Size>38f,14f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text><Variable name="EqLabel"/></Text>
              <Alignment>center</Alignment>
              <Unpressed scalemode="STRETCH">skin:rb/eq_kill_off.svg</Unpressed>
              <Pressed scalemode="STRETCH">skin:rb/eq_kill_on.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text><Variable name="EqLabel"/></Text>
              <Alignment>center</Alignment>
              <Unpressed scalemode="STRETCH">skin:rb/eq_kill_on.svg</Unpressed>
              <Pressed scalemode="STRETCH">skin:rb/eq_kill_on.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="EqEffect"/>,button_parameter<Variable name="EqParameter"/></ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
    <Connection>
      <ConfigKey><Variable name="EqEffect"/>,parameter<Variable name="EqParameter"/>_loaded</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
