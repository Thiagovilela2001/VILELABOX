<!DOCTYPE template>
<!--
  RbxOriginal :: mixer/channel_fader.xml
  Lower half of a rekordbox channel strip: headphone CUE (blue when on) and
  the channel fader, which takes all the height left in the deck row.

  The fader is drawn like rekordbox's: no cap, a hairline track (BarBg), a blue
  level line from the bottom to the handle (Bar) and a thin line as handle.
  BarMargins = half the handle length (20 px wide x 8/20 -> 8 px), so the blue
  line ends exactly at the handle. The ticks sit beside the track, so they
  never take mouse presses from the slider.

  The level meter stretches with the fader (scalemode STRETCH on flat colour
  zones, see tools/make_rb.py); it is offset by the same 4 px as the track.
  Variables: ChanNum
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>RbxChannelFader<Variable name="ChanNum"/></ObjectName>
    <Layout>vertical</Layout>
    <Size>80f,0me</Size>
    <Children>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>80f,20f</Size>
        <Children>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
          <Template src="skin:controls/btn_2state.xml">
            <SetVariable name="TooltipId">pfl</SetVariable>
            <SetVariable name="ObjectName">HeadphoneCue</SetVariable>
            <SetVariable name="Size">44f,20f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">CUE</SetVariable>
            <SetVariable name="state_1_text">CUE</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,pfl</SetVariable>
          </Template>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>0me,8f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>80f,0me</Size>
        <MinimumSize>80,120</MinimumSize>
        <Children>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
          <!-- 4 + 3 on the left mirror the 3 + 4 meter on the right, so the
               track is centred under the CUE button. -->
          <WidgetGroup><Size>7f,0me</Size></WidgetGroup>

          <Template src="skin:mixer/fader_ticks.xml"/>

          <SliderComposed>
            <TooltipId>channel_volume</TooltipId>
            <ObjectName>VolumeSlider</ObjectName>
            <Size>20f,0me</Size>
            <Slider scalemode="STRETCH">skin:rb/blank.svg</Slider>
            <Handle scalemode="STRETCH_ASPECT">skin:rb/fader_handle.svg</Handle>
            <Horizontal>false</Horizontal>
            <BarColor>#1473eb</BarColor>
            <BarWidth>2</BarWidth>
            <BarMargins>4,4</BarMargins>
            <BarBgColor>#3c3c3c</BarBgColor>
            <BarBgWidth>2</BarBgWidth>
            <BarAxisPos>10</BarAxisPos>
            <BarUnipolar>true</BarUnipolar>
            <Connection>
              <ConfigKey><Variable name="Group"/>,volume</ConfigKey>
            </Connection>
          </SliderComposed>

          <Template src="skin:mixer/fader_ticks.xml"/>

          <WidgetGroup><Size>3f,0me</Size></WidgetGroup>
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>4f,0me</Size>
            <Children>
              <WidgetGroup><Size>0me,4f</Size></WidgetGroup>
              <VuMeter>
                <TooltipId>channel_VuMeter</TooltipId>
                <ObjectName>ChannelVu</ObjectName>
                <Size>4f,0me</Size>
                <PathBack scalemode="STRETCH">skin:bases/vu_rb_v_bg.png</PathBack>
                <PathVu scalemode="STRETCH">skin:bases/vu_rb_v_active.png</PathVu>
                <Horizontal>false</Horizontal>
                <PeakHoldSize>2</PeakHoldSize>
                <PeakHoldTime>500</PeakHoldTime>
                <PeakFallTime>10</PeakFallTime>
                <PeakFallStep>2</PeakFallStep>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,vu_meter</ConfigKey>
                </Connection>
              </VuMeter>
              <WidgetGroup><Size>0me,4f</Size></WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
