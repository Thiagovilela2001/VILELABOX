<!DOCTYPE template>
<!--
  RbxFlow :: decks/transport.xml   (look pass 3)
  The round CUE / PLAY pair, Rekordbox-style, with the deck flags under them:

      ( CUE )  ( >|| )
      SLIP  Q  KEY  REV

  Both rounds are 70x70 with border-radius 35px in style.qss; the pixmap is the
  transparent blank, so the disc, ring and lit state are pure QSS.
  Right-click: CUE = go to cue and stop, PLAY = set cue.
  Variables: Group
-->
<Template>
  <WidgetGroup>
    <ObjectName>RbxTransport</ObjectName>
    <Layout>vertical</Layout>
    <Size>146f,102f</Size>
    <Children>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>146f,72f</Size>
        <Children>
          <PushButton>
            <TooltipId>cue_default_cue_gotoandstop</TooltipId>
            <ObjectName>CueDeck</ObjectName>
            <Size>70f,70f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>true</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>CUE</Text>
              <Alignment>center</Alignment>
              <Unpressed scalemode="STRETCH">skin:bases/btn_blank.svg</Unpressed>
              <Pressed scalemode="STRETCH">skin:bases/btn_blank_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>CUE</Text>
              <Alignment>center</Alignment>
              <Unpressed scalemode="STRETCH">skin:bases/btn_blank_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skin:bases/btn_blank_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_default</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_gotoandstop</ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_indicator</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>8f,0me</Size></WidgetGroup>
          <PushButton>
            <TooltipId>play_cue_set</TooltipId>
            <ObjectName>PlayDeck</ObjectName>
            <Size>70f,70f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>true</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>&#9654;&#10074;&#10074;</Text>
              <Alignment>center</Alignment>
              <Unpressed scalemode="STRETCH">skin:bases/btn_blank.svg</Unpressed>
              <Pressed scalemode="STRETCH">skin:bases/btn_blank_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>&#9654;&#10074;&#10074;</Text>
              <Alignment>center</Alignment>
              <Unpressed scalemode="STRETCH">skin:bases/btn_blank_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skin:bases/btn_blank_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,play</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_set</ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,play_indicator</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>0me,8f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>146f,22f</Size>
        <Children>
          <Template src="skin:controls/btn_2state.xml">
            <SetVariable name="TooltipId">slip_mode</SetVariable>
            <SetVariable name="ObjectName">SlipMode</SetVariable>
            <SetVariable name="Size">28me,22f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">SLIP</SetVariable>
            <SetVariable name="state_1_text">SLIP</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,slip_enabled</SetVariable>
          </Template>
          <WidgetGroup><Size>3f,0me</Size></WidgetGroup>
          <Template src="skin:controls/btn_2state.xml">
            <SetVariable name="TooltipId">quantize</SetVariable>
            <SetVariable name="ObjectName">Quantize</SetVariable>
            <SetVariable name="Size">22f,22f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">Q</SetVariable>
            <SetVariable name="state_1_text">Q</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,quantize</SetVariable>
          </Template>
          <WidgetGroup><Size>3f,0me</Size></WidgetGroup>
          <Template src="skin:controls/btn_2state.xml">
            <SetVariable name="TooltipId">keylock</SetVariable>
            <SetVariable name="ObjectName">KeyLock</SetVariable>
            <SetVariable name="Size">28me,22f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">KEY</SetVariable>
            <SetVariable name="state_1_text">KEY</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,keylock</SetVariable>
          </Template>
          <WidgetGroup><Size>3f,0me</Size></WidgetGroup>
          <Template src="skin:controls/btn_1state_right.xml">
            <SetVariable name="TooltipId">reverse</SetVariable>
            <SetVariable name="ObjectName">Reverse</SetVariable>
            <SetVariable name="Size">28me,22f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">REV</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,reverse</SetVariable>
            <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,reverseroll</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
