<!DOCTYPE template>
<!--
  RbxFlow :: decks/deck.xml   (look pass 3)
  One deck card, Rekordbox 2-deck layout:

    header      [1] art  TITLE / artist          time   [KEY] [BPM]  MASTER/KEY SYNC
    overview    whole-track strip (recessed well)                      | grid tools
    body
      | LOOP  [-][ 4 ][+][LOOP]       BEAT JUMP  [<][ 4 ][>]         |  tempo
      |       [IN][OUT][RELOOP][ANCH]            [1][2][4][8][16]    |  dial,
      |                                                              |  sync,
      | ( CUE )( PLAY )   [ 1 ][ 2 ][ 3 ][ 4 ]                        |  pitch
      | SLIP Q KEY REV    [ 5 ][ 6 ][ 7 ][ 8 ]                        |  fader
  The tempo column runs the FULL card height (beside the header too), so the
  pitch fader gets the long travel it needs.

  What changed from pass 2 and why:
    * The deck no longer carries its OWN scrolling waveform. The waveform band at
      the top already shows both decks scrolling; the copy inside the deck doubled
      the visual noise and cost 120 px. Rekordbox's deck shows the overview only.
      The overview, cover art and title are all track drop targets (WOverview /
      WCoverArt / WTrackProperty implement dropEvent), and the band waveforms
      still are too, so drag-to-load keeps working - see README rule 6c.
    * Hot-cue pads, loop and jump blocks are ELASTIC in width. Pass 2 used a
      fixed 370 px grid that left a dead channel at 1920 px. The pads' pixmap is
      transparent and the look is QSS, so stretching costs nothing.
    * CUE / PLAY are the big round pair at the bottom-left.
  Variables: ChanNum
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>RbxDeck<Variable name="ChanNum"/></ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,me</SizePolicy>
    <MinimumSize>440,300</MinimumSize>
    <Children>

      <WidgetGroup><Size>8f,0me</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <WidgetGroup><Size>0me,8f</Size></WidgetGroup>

          <!-- 1. header -->
          <Template src="skin:decks/track_info.xml">
            <SetVariable name="ChanNum"><Variable name="ChanNum"/></SetVariable>
            <SetVariable name="Group"><Variable name="Group"/></SetVariable>
          </Template>

          <WidgetGroup><Size>0me,8f</Size></WidgetGroup>

          <!-- 2. overview strip + beatgrid tools -->
          <WidgetGroup>
            <ObjectName>RbxOverviewBox<Variable name="ChanNum"/></ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,60f</Size>
            <Children>
              <Template src="skin:decks/overview.xml">
                <SetVariable name="ChanNum"><Variable name="ChanNum"/></SetVariable>
              </Template>
              <WidgetGroup><Size>6f,0me</Size></WidgetGroup>
              <Template src="skin:decks/beatgrid_controls.xml">
                <SetVariable name="ChanNum"><Variable name="ChanNum"/></SetVariable>
              </Template>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>0me,10f</Size></WidgetGroup>

          <!-- 3. body -->
          <WidgetGroup>
            <ObjectName>RbxDeckBody<Variable name="ChanNum"/></ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <WidgetGroup>
                <ObjectName>RbxDeckMain<Variable name="ChanNum"/></ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>

                  <!-- loop | beat jump -->
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,max</SizePolicy>
                    <Children>
                      <Template src="skin:decks/loop.xml">
                        <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                      </Template>
                      <WidgetGroup><Size>12f,0me</Size></WidgetGroup>
                      <Template src="skin:decks/beatjump.xml">
                        <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                      </Template>
                      <WidgetGroup><Size>12f,0me</Size></WidgetGroup>
                      <Template src="skin:decks/barjump.xml">
                        <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>

                  <!-- the only elastic gap: keeps the transport on the card's
                       bottom edge, level with the mixer's crossfader -->
                  <WidgetGroup><Size>0me,10me</Size></WidgetGroup>

<Template src="skin:decks/vilelabox_pads.xml"><SetVariable name="ChanNum"><Variable name="ChanNum"/></SetVariable><SetVariable name="Group"><Variable name="Group"/></SetVariable></Template>
                  <!-- transport | hot cues -->
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,max</SizePolicy>
                    <Children>
                      <Template src="skin:decks/transport.xml">
                        <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                      </Template>
                      <WidgetGroup><Size>12f,0me</Size></WidgetGroup>
                      <Template src="skin:decks/hotcues.xml">
                        <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>

                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>0me,8f</Size></WidgetGroup>

        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>10f,0me</Size></WidgetGroup>

      <!-- tempo column: the full card height, so the pitch fader is long -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <Size>84f,0me</Size>
        <Children>
          <WidgetGroup><Size>0me,8f</Size></WidgetGroup>
          <Template src="skin:decks/rate.xml">
            <SetVariable name="ChanNum"><Variable name="ChanNum"/></SetVariable>
            <SetVariable name="Group"><Variable name="Group"/></SetVariable>
          </Template>
          <WidgetGroup><Size>0me,8f</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>8f,0me</Size></WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
