<!DOCTYPE skin>
<!--
  ============================================================================
  RbxFlow — a Mixxx 2.5 skin with a Rekordbox-inspired information architecture.

  Architecture reference only: the layout logic, zone hierarchy and performance
  flow follow the idea of a modern DJ application (library -> prepare -> decks
  -> mixer -> performance). No image, icon, font or artwork from Rekordbox or
  any other product is used; every graphic here is generated by
  tools/make_assets.py and every layout file is written from scratch.

  Layout, top to bottom:
      TOP BAR            status: layout toggles, clock, CPU, REC, settings
      WAVEFORM BAND      two stacked horizontal deck waveforms (A / B)
      DECK A | MIXER | DECK B
      LIBRARY            crates/playlists + sortable track table + search
  ============================================================================
-->
<skin>
  <manifest>
    <title>RbxFlowBars</title>
    <author>RbxFlow contributors</author>
    <version>0.1.0</version>
    <description>Dense, dark DJ skin with Rekordbox-style zone hierarchy: stacked horizontal waveforms, track-info deck headers, integrated channel strips and a crate-first library.</description>
    <language>en</language>
    <license>GNU General Public License v2.0 or later</license>
    <attributes>

      <!-- ============ engine / layout defaults ============ -->
      <attribute config_key="[App],num_decks">2</attribute>
      <attribute config_key="[App],num_samplers">4</attribute>
      <attribute config_key="[App],num_preview_decks">1</attribute>
      <attribute config_key="[App],leftdeck">1</attribute>
      <attribute config_key="[App],rightdeck">2</attribute>

      <!-- ============ skin toggles (all editable in the SETTINGS panel) === -->
      <attribute persist="true" config_key="[RbxFlow],show_waveform_band">1</attribute>
      <attribute persist="true" config_key="[Vilelabox],waveform_rgb">0</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_mixer">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_library">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_big_library">0</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_settings">0</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_hotcues">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_8_hotcues">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_loop_controls">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_beatjump_controls">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_beatgrid_controls">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_intro_outro">0</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_pitch">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_eq">1</attribute>
      <attribute persist="true" config_key="[RbxFlow],show_xfader">1</attribute>

    </attributes>
  </manifest>

  <Schemes>
    <Scheme>
      <Name>RbxFlow</Name>
      <Style src="skin:style.qss"/>

      <!--  waveform / overview palette 
           Low/Mid/High follow the measured Rekordbox waveform colours
           (blue bass, amber mids, white highs) on a black ground. -->
      <SetVariable name="BgColorOverview">#050506</SetVariable>
      <SetVariable name="BgColorWaveform">#050506</SetVariable>
      <!-- SignalColor is what Mixxx paints the PRE-ROLL triangles with (the
           area before the track starts / after it ends). At #7f8b95 they were a
           loud grey sawtooth across half of every waveform; now a quiet hint. -->
      <SetVariable name="SignalColor">#1a1c20</SetVariable>
      <SetVariable name="SignalHighColor">#ffffff</SetVariable>
      <SetVariable name="SignalMidColor">#ffa600</SetVariable>
      <SetVariable name="SignalLowColor">#0055e1</SetVariable>
      <SetVariable name="SignalRGBHighColor">#ffffff</SetVariable>
      <SetVariable name="SignalRGBMidColor">#ffa600</SetVariable>
      <SetVariable name="SignalRGBLowColor">#0055e1</SetVariable>

      <SetVariable name="DimBrightThresholdOverview">120</SetVariable>
      <SetVariable name="DimBrightThresholdWaveform">100</SetVariable>
      <SetVariable name="DimBrightThresholdHotcueBtn">100</SetVariable>

      <!--  marker colours  -->
      <SetVariable name="AxesColor">#1c1e22</SetVariable>
      <SetVariable name="BeatColor">#4a4e56</SetVariable>
      <SetVariable name="PlayPosColor">#ffffff</SetVariable>
      <SetVariable name="CueColor">#ff8c1a</SetVariable>
      <SetVariable name="LoopColor">#36d860</SetVariable>
      <SetVariable name="IntroOutroColor">#2f8cff</SetVariable>
      <SetVariable name="PlayedOverlayColor">#b3000000</SetVariable>
      <SetVariable name="EndOfTrackColor">#ff4b4b</SetVariable>
      <SetVariable name="SlipBorderOutlineColor">#ffa600</SetVariable>
      <SetVariable name="PassthroughLabelColor">#8a939c</SetVariable>
      <SetVariable name="OverviewFontSize">10</SetVariable>

      <!--  knobs  -->
      <SetVariable name="PotiMinAngle">-135</SetVariable>
      <SetVariable name="PotiMaxAngle">135</SetVariable>
      <SetVariable name="ArcRadiusBig">15.5</SetVariable>
      <SetVariable name="ArcRadiusCompact">12.0</SetVariable>
      <SetVariable name="ArcThickness">2.5</SetVariable>
      <SetVariable name="ArcThicknessBig">3</SetVariable>
      <SetVariable name="ArcRoundCaps">true</SetVariable>
      <SetVariable name="ArcColorEq">#d0d2d6</SetVariable>
      <SetVariable name="ArcColorGain">#ff8c1a</SetVariable>
      <SetVariable name="ArcColorGainLow">#ff8c1a</SetVariable>
      <SetVariable name="ArcColorMstBal">#2f8cff</SetVariable>

      <!--  sliders  -->
      <SetVariable name="BarBgColor">#07080a</SetVariable>
      <SetVariable name="BarColorVolume">#2f8cff</SetVariable>
      <SetVariable name="BarColorCrossfader">#2f8cff</SetVariable>
      <SetVariable name="BarColorPitch">#ff8c1a</SetVariable>
      <SetVariable name="BarWidth">3</SetVariable>
      <SetVariable name="BarMarginVolume">8,8</SetVariable>
      <SetVariable name="BarMarginPitch">9,7</SetVariable>
      <SetVariable name="BarMarginCrossfader">7,7</SetVariable>
    </Scheme>
  </Schemes>

  <ObjectName>Mixxx</ObjectName>
  <Style src="skin:style.qss"
         src-linux="skins:default-menu-styles-linux.qss"
         src-windows="skins:default-menu-styles-windows.qss"/>
  <!-- Smallest supported window: nothing important is allowed to disappear.
       1280x668 is Mixxx's own documented minimum for resizable skins. -->
  <MinimumSize>1280,668</MinimumSize>
  <SizePolicy>me,me</SizePolicy>
  <Layout>vertical</Layout>
  <Children>

    <WidgetGroup>
      <ObjectName>RbxSkinContainer</ObjectName>
      <Layout>vertical</Layout>
      <SizePolicy>me,me</SizePolicy>
      <Children>

        <!--  Outer gutter. Mixxx has no margin/padding tag for a layout, so the
              inset is made from fixed-size spacer groups. Without it every zone
              is flush against the window edge and deck A's title is clipped by
              the frame on the left.  -->
        <WidgetGroup><Size>0me,6f</Size></WidgetGroup>

        <WidgetGroup>
          <ObjectName>RbxSkinBody</ObjectName>
          <Layout>horizontal</Layout>
          <SizePolicy>me,me</SizePolicy>
          <Children>

            <WidgetGroup><Size>6f,0me</Size></WidgetGroup>

            <WidgetGroup>
              <ObjectName>RbxSkinColumn</ObjectName>
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>

        <!-- ================= TOP BAR ================= -->
        <Template src="skin:topbar.xml"/>
        <WidgetGroup><Size>0me,6f</Size></WidgetGroup>

        <!-- ============ main view vs maximised library ============ -->
        <WidgetStack currentpage="[RbxFlow],show_big_library" persist="true">
          <Children>

            <!-- normal performance view -->
            <WidgetGroup>
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>

                <!-- ============ WAVEFORM BAND ============ -->
                <!--  SplitSizes are a ratio, not pixels: Qt scales them so they
                      fill the splitter, then clamps to each child's minimum.
                      They are therefore written to sum to roughly one screen
                      height so the intended proportion survives scaling.  -->
                <Splitter>
                  <ObjectName>RbxWaveSplitter</ObjectName>
                  <Orientation>vertical</Orientation>
                  <SizePolicy>me,me</SizePolicy>
                  <SplitSizes>150,930</SplitSizes>
                  <SplitSizesConfigKey>[RbxFlow],waveform_splitsize</SplitSizesConfigKey>
                  <Collapsible>1,0</Collapsible>
                  <Children>

                    <Template src="skin:waveforms_container.xml"/>

                    <!-- ============ DECKS + MIXER + LIBRARY ============ -->
                    <WidgetGroup>
                      <ObjectName>RbxDeckMixerLibrary</ObjectName>
                      <Layout>vertical</Layout>
                      <SizePolicy>me,me</SizePolicy>
                      <Children>

                        <!--  The deck/mixer row takes exactly the height its
                              content needs; the library below absorbs all the
                              window's spare height. That is what removes the
                              large empty bands that used to open under the
                              mixer and inside each deck.  -->
                        <WidgetGroup>
                          <ObjectName>RbxDeckMixerRow</ObjectName>
                          <Layout>horizontal</Layout>
                          <!-- `max` = ShrinkFlag only: the row takes exactly
                               the height its content needs and refuses to grow,
                               so the library below gets every spare pixel. -->
                          <SizePolicy>me,max</SizePolicy>
                          <Children>

                            <!-- DECK A -->
                            <Template src="skin:decks/deck.xml">
                              <SetVariable name="ChanNum">1</SetVariable>
                            </Template>

                            <WidgetGroup><Size>6f,0me</Size></WidgetGroup>

                            <!-- MIXER (CH A -> MASTER -> CH B) -->
                            <Template src="skin:mixer/mixer.xml"/>

                            <WidgetGroup><Size>6f,0me</Size></WidgetGroup>

                            <!-- DECK B -->
                            <Template src="skin:decks/deck.xml">
                              <SetVariable name="ChanNum">2</SetVariable>
                            </Template>

                          </Children>
                        </WidgetGroup>

                        <WidgetGroup><Size>0me,6f</Size></WidgetGroup>

                        <!-- ============ LIBRARY ============ -->
                        <Template src="skin:library.xml"/>

                      </Children>
                    </WidgetGroup>

                  </Children>
                </Splitter>

              </Children>
            </WidgetGroup>

            <!-- maximised library view: decks shrink to a compact strip -->
            <WidgetGroup>
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>
                <Template src="skin:library.xml"/>
              </Children>
            </WidgetGroup>

          </Children>
        </WidgetStack>

        <!-- ================= SETTINGS PANEL ================= -->
        <Template src="skin:skin_settings.xml"/>

              </Children>
            </WidgetGroup>

            <WidgetGroup><Size>6f,0me</Size></WidgetGroup>

          </Children>
        </WidgetGroup>

        <WidgetGroup><Size>0me,6f</Size></WidgetGroup>

      </Children>
    </WidgetGroup>

  </Children>
</skin>