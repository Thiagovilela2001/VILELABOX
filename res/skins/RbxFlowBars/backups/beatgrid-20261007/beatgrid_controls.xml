<!DOCTYPE template>
<!--
  RbxFlow :: decks/beatgrid_controls.xml   (look pass 3)
  Beat-grid tools beside the overview, 60 px tall to match it:
      [GRID] [<]      GRID  = snap the grid to the play position
             [>]              (right-click: match alignment with the other deck)
                      < / > = shift the grid earlier / later
  Two fixes from pass 2:
    * GRID's visibility was bound to [ChannelN],bpmlock, i.e. it was shown ONLY
      while the grid was locked - exactly backwards - so it never appeared.
    * ">" was wired to beats_adjust_faster (changes the BPM), not to
      beats_translate_later, so the pair did not mirror each other.
  Variables: ChanNum
-->
<Template>
  <WidgetGroup>
    <ObjectName>RbxBeatgridTools<Variable name="ChanNum"/></ObjectName>
    <Layout>horizontal</Layout>
    <Size>66f,60f</Size>
    <Children>

      <Template src="skin:controls/btn_1state_right.xml">
        <SetVariable name="TooltipId">beats_translate_curpos</SetVariable>
        <SetVariable name="ObjectName">BeatCurpos</SetVariable>
        <SetVariable name="Size">36f,60f</SetVariable>
        <SetVariable name="BtnSize">blank</SetVariable>
        <SetVariable name="state_0_text">GRID</SetVariable>
        <SetVariable name="Align">center</SetVariable>
        <SetVariable name="ConfigKey">[Channel<Variable name="ChanNum"/>],beats_translate_curpos</SetVariable>
        <SetVariable name="ConfigKeyRight">[Channel<Variable name="ChanNum"/>],beats_translate_match_alignment</SetVariable>
      </Template>

      <WidgetGroup><Size>3f,0me</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>vertical</Layout>
        <Size>27f,60f</Size>
        <Children>
          <Template src="skin:controls/btn_1state_right.xml">
            <SetVariable name="TooltipId">beats_translate_earlier</SetVariable>
            <SetVariable name="ObjectName">BeatsEarlier</SetVariable>
            <SetVariable name="Size">27f,28f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">&#9664;</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey">[Channel<Variable name="ChanNum"/>],beats_translate_earlier</SetVariable>
          </Template>
          <WidgetGroup><Size>0me,4f</Size></WidgetGroup>
          <Template src="skin:controls/btn_1state_right.xml">
            <SetVariable name="TooltipId">beats_translate_later</SetVariable>
            <SetVariable name="ObjectName">BeatsLater</SetVariable>
            <SetVariable name="Size">27f,28f</SetVariable>
            <SetVariable name="BtnSize">blank</SetVariable>
            <SetVariable name="state_0_text">&#9654;</SetVariable>
            <SetVariable name="Align">center</SetVariable>
            <SetVariable name="ConfigKey">[Channel<Variable name="ChanNum"/>],beats_translate_later</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

    </Children>
    <Connection>
      <ConfigKey persist="true">[RbxFlow],show_beatgrid_controls</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
